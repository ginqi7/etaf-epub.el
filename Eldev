; -*- mode: emacs-lisp; lexical-binding: t -*-

;; Eldev configuration for etaf-epub.el

(eldev-use-package-archive 'gnu-elpa)
(eldev-use-package-archive 'nongnu-elpa)
(eldev-use-package-archive 'melpa)

;; `etaf', its `ebox' and `ecss' dependencies and `ekp' are published
;; on the ETAF archive.
(eldev-use-package-archive (cons "etaf" "https://etaf.top/packages/"))

;; `etaf-html' is the HTML renderer this project is built on.  It is not
;; published on its own yet: it lives in the `etaf-html.el' repository,
;; which Eldev can fetch as the `etaf-html' package.
;;
;; Point `ETAF_HTML_DIR' at a local checkout of that repository to build
;; against the copy of `etaf-html.el' under development in it.  Without
;; that variable the repository is fetched.
(if-let* ((dir (getenv "ETAF_HTML_DIR")))
    (eldev-use-local-sources dir)
  (eldev-use-vc-repository 'etaf-html :github "ginqi7/etaf-html.el"))

;; `etaf-html' is not declared in `etaf-epub.el's package metadata yet;
;; it brings in `etaf', `ebox', `ecss' and `ekp' through its own
;; `Package-Requires'.
(dolist (set '(runtime compile build test))
  (eldev-add-extra-dependencies set '(:package etaf-html)))
